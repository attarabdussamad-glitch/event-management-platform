// Prisma schema for Event Management Platform
// Professional Mega Career & Recruitment Fair - Mumbai

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // For Neon: also set DATABASE_URL_UNPOOLED for migrations if needed
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ==================== AUTH & RBAC ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  image         String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         UserRole[]
  checkIns      CheckIn[]  @relation("CheckedInBy")
  auditLogs     AuditLog[]
  sessions      Session[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ==================== EVENT CONFIG ====================

model Event {
  id              String   @id @default(cuid())
  name            String   @default("Professional Mega Career & Recruitment Fair")
  tagline         String   @default("Where Talent Meets Opportunity.")
  description     String   @db.Text
  category        String   @default("Career Fair, Job Fair, Recruitment Expo")
  location        String   @default("Mumbai, Maharashtra, India")
  venueName       String?
  venueAddress    String?  @db.Text
  googleMapsUrl   String?
  startDate       DateTime?
  endDate         DateTime?
  startTime       String?
  endTime         String?
  timezone        String   @default("Asia/Kolkata")
  capacity        Int?
  organizerName   String?
  organizerEmail  String?
  organizerPhone  String?
  websiteUrl      String?
  logoUrl         String?
  bannerUrl       String?
  faviconUrl      String?
  primaryColor    String   @default("#0f172a")
  secondaryColor  String   @default("#f59e0b")
  backgroundColor String   @default("#ffffff")
  textColor       String   @default("#0f172a")
  fontFamily      String   @default("Inter")
  socialLinks     Json?
  registrationMode String  @default("OPEN")
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pages           EventPage[]
  ticketTypes     TicketType[]
  registrations   Registration[]
  speakers        Speaker[]
  sponsors        Sponsor[]
  exhibitors      Exhibitor[]
  spocs           Spoc[]
  formFields      RegistrationFormField[]
  jobOpportunities JobOpportunity[]
  employers       Employer[]
  enquiries       Enquiry[]

  @@map("events")
}

model EventPage {
  id          String   @id @default(cuid())
  eventId     String
  slug        String
  title       String
  content     Json?
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slug])
  @@map("event_pages")
}

// ==================== TICKETS & REGISTRATION ====================

model TicketType {
  id              String   @id @default(cuid())
  eventId         String
  name            String
  description     String?
  category        String
  price           Decimal  @default(0) @db.Decimal(10, 2)
  currency        String   @default("INR")
  capacity        Int?
  requiresApproval Boolean @default(false)
  requiresPayment  Boolean @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations   Registration[]
  formFields      RegistrationFormField[]
  spocAssignments SpocAssignment[]

  @@map("ticket_types")
}

model RegistrationFormField {
  id           String   @id @default(cuid())
  eventId      String
  ticketTypeId String?
  name         String
  label        String
  fieldType    String
  options      Json?
  isRequired   Boolean  @default(false)
  sortOrder    Int      @default(0)
  placeholder  String?
  helpText     String?
  validation   Json?
  createdAt    DateTime @default(now())

  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@map("registration_form_fields")
}

model Registration {
  id              String   @id @default(cuid())
  eventId         String
  ticketTypeId    String
  registrationId  String   @unique
  status          String   @default("PENDING")
  fullName        String
  email           String
  phone           String?
  organization    String?
  designation     String?
  city            String?
  country         String?  @default("India")
  answers         Json?
  consentGiven    Boolean  @default(false)
  consentAt       DateTime?
  invitationCode  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType      TicketType  @relation(fields: [ticketTypeId], references: [id])
  ticket          Ticket?
  jobSeekerProfile JobSeekerProfile?
  checkIns        CheckIn[]

  @@index([email, eventId])
  @@index([registrationId])
  @@map("registrations")
}

model Ticket {
  id              String   @id @default(cuid())
  registrationId  String   @unique
  ticketNumber    String   @unique
  verificationToken String @unique
  qrCodeDataUrl   String?  @db.Text
  status          String   @default("VALID")
  issuedAt        DateTime @default(now())
  expiresAt       DateTime?

  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkIns        CheckIn[]

  @@map("tickets")
}

model CheckIn {
  id           String   @id @default(cuid())
  ticketId     String
  registrationId String
  checkedInById String?
  checkedInAt  DateTime @default(now())
  notes        String?
  deviceInfo   String?

  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkedInBy  User?    @relation("CheckedInBy", fields: [checkedInById], references: [id])

  @@map("check_ins")
}

// ==================== SPOC ====================

model Spoc {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  designation  String?
  department   String?
  email        String
  phone        String?
  whatsapp     String?
  photoUrl     String?
  responsibility String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments  SpocAssignment[]

  @@map("spocs")
}

model SpocAssignment {
  id           String @id @default(cuid())
  spocId       String
  ticketTypeId String

  spoc         Spoc       @relation(fields: [spocId], references: [id], onDelete: Cascade)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([spocId, ticketTypeId])
  @@map("spoc_assignments")
}

// ==================== CAREER FAIR SPECIFIC ====================

model JobSeekerProfile {
  id              String   @id @default(cuid())
  registrationId  String   @unique
  education       String?
  qualification   String?
  skills          String?  @db.Text
  experienceLevel String?
  preferredIndustry String?
  preferredRole   String?
  locationPreference String?
  availability    String?
  linkedinUrl     String?
  portfolioUrl    String?
  resumeUrl       String?
  resumeFileName  String?
  consentToShare  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registration    Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("job_seeker_profiles")
}

model Employer {
  id              String   @id @default(cuid())
  eventId         String
  organizationName String
  industry        String?
  website         String?
  description     String?  @db.Text
  logoUrl         String?
  contactName     String
  contactEmail    String
  contactPhone    String?
  designation     String?
  hiringNeeds     String?  @db.Text
  boothRequired   Boolean  @default(false)
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  jobs            JobOpportunity[]

  @@map("employers")
}

model JobOpportunity {
  id              String   @id @default(cuid())
  eventId         String
  employerId      String?
  title           String
  description     String?  @db.Text
  industry        String?
  experienceLevel String?
  location        String?
  vacancies       Int      @default(1)
  employmentType  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employer        Employer? @relation(fields: [employerId], references: [id])

  @@map("job_opportunities")
}

model Enquiry {
  id              String   @id @default(cuid())
  eventId         String
  type            String
  organizationName String
  contactName     String
  contactEmail    String
  contactPhone    String?
  message         String?  @db.Text
  partnershipCategory String?
  proposedContribution String? @db.Text
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("enquiries")
}

// ==================== CONTENT ====================

model Speaker {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  title       String?
  organization String?
  bio         String?  @db.Text
  photoUrl    String?
  linkedinUrl String?
  sessionTitle String?
  sessionTime String?
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("speakers")
}

model Sponsor {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  tier        String?
  logoUrl     String?
  website     String?
  description String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("sponsors")
}

model Exhibitor {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  logoUrl     String?
  boothNumber String?
  website     String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("exhibitors")
}

// ==================== EMAIL & AUDIT ====================

model EmailLog {
  id          String   @id @default(cuid())
  toEmail     String
  subject     String
  template    String?
  status      String
  resendId    String?
  error       String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("email_logs")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
